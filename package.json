{
    "name": "vscode-jupyter-docker-stack-connect",
    "displayName": "Jupyter Docker Stack Connect",
    "description": "",
    "version": "0.0.2",
    "engines": {
        "vscode": "^1.75.0"
    },
    "publisher": "rebornix",
    "categories": [
        "Data Science"
    ],
    "extensionDependencies": [
        "ms-toolsai.jupyter"
    ],
    "activationEvents": [
        "onNotebook:jupyter-notebook"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/rebornix/vscode-jupyter-docker-stack-connect"
    },
    "main": "./out/extension.js",
    "contributes": {
        "pythonRemoteServerProvider": [
            {
                "id": "jupyter-docker-stack-connect"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Jupyter Docker Stack Connect",
            "properties": {
                "jupyter-docker-stack-connect.containerImage": {
                    "type": "string",
                    "default": "jupyter/scipy-notebook:85f615d5cafa",
                    "description": "Docker container image to use for Jupyter server",
                    "examples": [
                        "jupyter/scipy-notebook:85f615d5cafa",
                        "quay.io/jupyter/scipy-server:latest",
                        "docker.io/library/jupyter/scipy-notebook"
                    ]
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "yarn run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "yarn run compile && yarn run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/glob": "^7.2.0",
        "@types/mocha": "^9.1.0",
        "@types/node": "14.x",
        "@types/vscode": "^1.74.0",
        "@typescript-eslint/eslint-plugin": "^5.16.0",
        "@typescript-eslint/parser": "^5.16.0",
        "@vscode/test-electron": "^2.1.3",
        "@vscode/jupyter-extension": "^1.0.0",
        "eslint": "^8.11.0",
        "glob": "^7.2.0",
        "mocha": "^9.2.2",
        "ts-loader": "^9.2.5",
        "typescript": "^4.5.5",
        "webpack": "^5.52.1",
        "webpack-cli": "^4.8.0"
    },
    "dependencies": {
        "is-reachable": "^5.2.1"
    }
}